{
  "name": "crowd-funding",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "db:migrate": "node scripts/migrate.mjs",
    "build": "next build",
    "start": "next start",
    "start:prod": "pnpm db:migrate && next start",
    "lint": "eslint",
    "test:unit": "vitest run --config vitest.config.ts tests/unit --passWithNoTests",
    "test:integration": "vitest run --config vitest.config.ts tests/integration --passWithNoTests",
    "test:e2e": "playwright test --config playwright.config.ts --pass-with-no-tests",
    "check": "pnpm lint && pnpm build && pnpm test:unit"
  },
  "dependencies": {
    "next": "16.2.6",
    "pg": "^8.20.0",
    "pnpm": "^11.0.9",
    "qrcode.react": "^4.2.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.5"
  }
}
