# PostgreSQL
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# Single admin account
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="replace-with-admin-password"
SESSION_SECRET="replace-with-long-random-secret"

# ZPAY
ZPAY_MCH_ID="replace-with-zpay-merchant-id"
ZPAY_KEY="replace-with-zpay-signing-key"
ZPAY_NOTIFY_URL="https://example.com/api/payments/notify"
ZPAY_RETURN_URL="https://example.com/payment/return"

# Tencent Cloud TMS
TENCENT_SECRET_ID="replace-with-tencent-secret-id"
TENCENT_SECRET_KEY="replace-with-tencent-secret-key"
TENCENT_TMS_REGION="ap-beijing"
# Optional local/staging override; leave unset in production unless using a private proxy.
TENCENT_TMS_ENDPOINT=""

# MinIO object storage
MINIO_ENDPOINT="https://minio.example.com"
MINIO_BUCKET="expense-assets"
MINIO_REGION="us-east-1"
MINIO_ACCESS_KEY_ID="replace-with-minio-access-key"
MINIO_SECRET_ACCESS_KEY="replace-with-minio-secret-key"
PUBLIC_ASSET_BASE_URL="https://assets.example.com"
