# PostgreSQL
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# Single admin account
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="replace-with-admin-password"
SESSION_SECRET="replace-with-long-random-secret"

# WeChat Pay
WECHAT_PAY_APP_ID="mini-program-appid"
WECHAT_PAY_MCH_ID="merchant-id"
WECHAT_PAY_API_V3_KEY="32-byte-api-v3-key"
WECHAT_PAY_MERCHANT_SERIAL_NO="merchant-api-certificate-serial"
WECHAT_PAY_MERCHANT_PRIVATE_KEY_PATH="D:/secure/path/apiclient_key.pem"
WECHAT_PAY_PUBLIC_KEY_ID="PUB_KEY_ID_xxx-or-platform-cert-serial"
WECHAT_PAY_PUBLIC_KEY_PATH="D:/secure/path/wechatpay_public.pem"
WECHAT_PAY_NOTIFY_URL="https://example.com/api/payments/notify"
WECHAT_PAY_REFUND_NOTIFY_URL="https://example.com/api/refunds/notify"

# WeChat Mini Program
WECHAT_MINI_PROGRAM_APP_SECRET="mini-program-app-secret"
WECHAT_MINI_PROGRAM_URL_LINK=""
WECHAT_MINI_PROGRAM_URL_SCHEME=""
NEXT_PUBLIC_WECHAT_MINI_PROGRAM_APP_ID="mini-program-appid"
NEXT_PUBLIC_WECHAT_MINI_PROGRAM_PATH="pages/crowdfunding/sponsor"

# Legacy ZPAY rollback only; not used by the default production payment flow.
ZPAY_MCH_ID=""
ZPAY_KEY=""
ZPAY_NOTIFY_URL=""
ZPAY_RETURN_URL=""

# Tencent Cloud TMS
TENCENT_SECRET_ID="replace-with-tencent-secret-id"
TENCENT_SECRET_KEY="replace-with-tencent-secret-key"
TENCENT_TMS_REGION="ap-beijing"
# Optional local/staging override; leave unset in production unless using a private proxy.
TENCENT_TMS_ENDPOINT=""

# MinIO object storage
MINIO_ENDPOINT="https://minio.example.com"
MINIO_BUCKET="expense-assets"
MINIO_REGION="us-east-1"
MINIO_ACCESS_KEY_ID="replace-with-minio-access-key"
MINIO_SECRET_ACCESS_KEY="replace-with-minio-secret-key"
PUBLIC_ASSET_BASE_URL="https://assets.example.com"
